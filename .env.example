# ============================================================================
# QNNX Backend — Environment Variables (TEMPLATE)
# ============================================================================
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` is gitignored; NEVER put real secrets in this .env.example file.
# ----------------------------------------------------------------------------

# --- Firebase Web config (client-facing; safe to expose, guarded by rules) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# --- Firebase service account (SERVER-ONLY, SECRET) --------------------------
# From Google Cloud Console -> IAM & Admin -> Service Accounts -> firebase-adminsdk.
# Keep the private key on a single line with literal \n for the newlines,
# wrapped in double quotes.
FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENTS_HERE\n-----END PRIVATE KEY-----\n"

# --- AWS S3 (SERVER-ONLY, SECRET) -------------------------------------------
AWS_REGION=your-aws-region
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# --- First-admin bootstrap (SERVER-ONLY, SECRET) ----------------------------
# Set a long random value ONLY while creating the first admin, then unset it
# in any deployed environment to disable the /api/users/[id]/role escape hatch.
ADMIN_BOOTSTRAP_SECRET=set-a-long-random-string-then-remove-in-prod

ADMIN_BOOTSTRAP_SECRET=
