rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    // Roles are authoritative in the Firebase custom claim (set by the backend
    // via /api/users/[id]/role), NOT the users document — so editing your own
    // users doc can never escalate your privileges here.
    // `.get()` with a default keeps this safe for users who have no claim yet
    // (e.g. brand-new signups still on the pending list).
    function roleClaim() {
      return isAuthenticated() ? request.auth.token.get('role', '') : '';
    }
    function hasRole(role) {
      return roleClaim() == role || (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role);
    }
    function isAdmin() { return hasRole('admin'); }
    function isLead() { return hasRole('lead'); }

    // Confidential document tiers that leads must NOT read.
    function isConfidentialDoc(cat) {
      return cat == 'employee-records' || cat == 'company-confidential';
    }

    // --- Users -----------------------------------------------------------
    // This document is the shared profile: name, email, role. It is readable by
    // any signed-in user so the app can render rosters, assignee names and the
    // lead list. That is only safe because it holds NO sensitive data —
    // phone / address / ssn live in the private subcollection below.
    // Rules cannot hide individual fields, so the split is what enforces this.
    //
    // Writes: a user may create their own doc as role 'pending' (signup) and
    // edit their own doc WITHOUT changing role; role changes happen only via
    // the backend service account, which bypasses these rules entirely.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == 'pending';
      // `.get()` on BOTH sides: a partial update that omits `role` must be
      // evaluated normally, not rejected with an error.
      allow update: if isAdmin()
                    || (isAuthenticated() && request.auth.uid == userId
                        && request.resource.data.get('role', '') == resource.data.get('role', ''));
      allow delete: if isAdmin();

      // --- Private PII (phone, address, ssn) ------------------------------
      // Written exclusively by the backend (PATCH /api/users/[id]), which uses
      // the service account and bypasses these rules. Clients may only READ,
      // and only their own document — admins may read anyone's.
      match /private/{docId} {
        allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow write: if false;
      }

      // --- Notifications ---------------------------------------------------
      // Users can read and update (to mark as read) their own notifications.
      // Notifications are created server-side by the API.
      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow create, delete: if false;
      }
    }

    // --- Teams -----------------------------------------------------------
    match /teams/{teamId} {
      allow read: if isAdmin() || isLead()
                  || (isAuthenticated() && request.auth.uid in resource.data.get('members', []));
      allow write: if false; // managed via backend
    }

    // --- Projects --------------------------------------------------------
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if false; // managed via backend
    }

    // --- Tasks -----------------------------------------------------------
    // Reads: admins/leads see all; a user sees tasks assigned to them.
    // A non-admin/non-lead client MUST constrain the query:
    //   query(collection(db,'tasks'), where('assigneeId','==',uid))
    // An unfiltered list is rejected outright — rules filter queries, not rows.
    // Writes: none from the client — all task writes go through the API.
    match /tasks/{taskId} {
      allow read: if isAdmin() || isLead()
                  || (isAuthenticated() && (resource.data.get('assigneeId', '') == request.auth.uid || request.auth.uid in resource.data.get('assignees', [])));
      allow create, update, delete: if false;
    }

    // --- Meetings --------------------------------------------------------
    // Same query constraint as tasks:
    //   where('participants','array-contains',uid)
    match /meetings/{meetingId} {
      allow read: if isAdmin() || isLead()
                  || (isAuthenticated() && request.auth.uid in resource.data.participants);
      allow create, update, delete: if false;
    }

    // --- Activity Log (shared feed) --------------------------------------
    // Read by leads/admins; written only by the backend (server activity log).
    match /activityLog/{logId} {
      allow read: if isAdmin() || isLead();
      allow create, update, delete: if false;
    }

    // --- Documents (metadata; files live in S3) --------------------------
    // Read policy mirrors the storage category tiers:
    //   admin: all
    //   lead : all except the confidential tier
    //   user : company-wide (policies, resources) + their own task/personal files
    // Writes: none from the client — recorded via the API.
    match /documents/{documentId} {
      allow read: if isAdmin()
                  || (isLead() && !isConfidentialDoc(resource.data.get('category', '')))
                  || (isAuthenticated()
                      && (resource.data.get('category', '') == 'policies'
                          || resource.data.get('category', '') == 'resources'))
                  || (isAuthenticated()
                      && resource.data.get('addedBy', '') == request.auth.uid
                      && (resource.data.get('category', '') == 'task-files'
                          || resource.data.get('category', '') == 'personal-files'));
      allow create, update, delete: if false;
    }
  }
}
